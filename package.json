{
  "name": "cardcodex",
  "private": true,
  "version": "1.10.5",
  "description": "Pokédex-style card collection tracker for the Pokémon and Yu-Gi-Oh! TCGs with camera card scanning. Web app (PWA) wrapped with Capacitor for Android.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "catalog": "node scripts/build-catalog.mjs",
    "catalog:ygo": "node scripts/build-ygo-catalog.mjs",
    "catalog:mtg": "node scripts/build-mtg-catalog.mjs",
    "data:manifest": "node scripts/data-manifest.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:release": "node scripts/android-release.mjs",
    "android:debug": "node scripts/android-release.mjs --debug",
    "hashes": "node scripts/build-hashes.mjs",
    "hashes:ygo": "node scripts/build-hashes.mjs --game ygo",
    "energy-refs": "node scripts/build-energy-refs.mjs",
    "decks:ygo": "node scripts/decks-ygo.mjs",
    "text": "node scripts/build-text.mjs",
    "text:ygo": "node scripts/build-ygo-text.mjs",
    "text:mtg": "node scripts/build-mtg-text.mjs",
    "deck-bench": "vitest run --config vitest.bench.config.ts",
    "deck-bench:update": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@capacitor-mlkit/text-recognition": "^8.2.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
